# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Primary app URL
VITE_APP_URL=https://agentnote.co.kr

# Keep empty for the Vercel + Supabase frontend-only deployment.
VITE_API_BASE_URL=

# Server-only AI briefing settings. Set these in Vercel Project Settings,
# not as NEXT_PUBLIC/VITE_PUBLIC client variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MODEL_FALLBACK=gpt-5-nano
AI_ENABLE_LLM=true
AI_MONTHLY_USD_HARD_LIMIT=5
AI_DAILY_USD_HARD_LIMIT=0.5
AI_PER_REQUEST_USD_HARD_LIMIT=0.02
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=2500
AI_MAX_INPUT_CHARS=16000
AI_MAX_PROPERTY_COUNT=5
AI_MIN_PROPERTY_COUNT=2
AI_MEMO_MAX_CHARS=500
AI_TIMEOUT_MS=60000
AI_RETRY_COUNT=0
AI_SHOW_COST_TO_ADMIN=true
